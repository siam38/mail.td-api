    "mailtd",
    "temp-mail",
    "temporary-email",
    "disposable-email",
    "otp",
    "scraper",
    "api",
    "express",
    "nodejs"
  ],
  "author": "SiAM (https://github.com/siam38)",
  "license": "MIT",
  "homepage": "https://github.com/siam38/mail.td-api#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/siam38/mail.td-api.git"
  },
  "bugs": {
    "url": "https://github.com/siam38/mail.td-api/issues"
  },
  "type": "module",
  "main": "src/mailtd.js",
  "exports": {
    ".": "./src/mailtd.js"
  },
  "scripts": {
    "start": "node src/server.js",
    "demo": "node examples/demo.js",
    "test": "node examples/demo.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "cors": "^2.8.5",
